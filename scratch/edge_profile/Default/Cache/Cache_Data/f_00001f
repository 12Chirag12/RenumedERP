                        <label class="cu-label" for="dprBatchDisplay">Selected batches <span class="req">*</span></label>
                        <input type="text" id="dprBatchDisplay" class="cu-input" readonly tabindex="-1" autocomplete="off" placeholder="BATCH01 — 1st (…) / BATCH02 — Single — double-click to clear">
                      </div>
                      <div class="cu-field">
                        <label class="cu-label" for="dprBatchAddSelect">Add log sheet row <span class="req">*</span></label>
                        <select id="dprBatchAddSelect" class="cu-select" autocomplete="off">
                          <option value="">Choose batch / colour slot to add…</option>
                        </select>
                      </div>
                      <div class="cu-field">
                        <label class="cu-label" for="dprBatchSizeLakh">Batch size (Lakh) <span class="req">*</span></label>
                        <input type="text" name="batch_size_lakh" class="cu-input cu-num" id="dprBatchSizeLakh" inputmode="decimal" autocomplete="off" placeholder="e.g. 2.5">
                        
                      </div>
                    </div>
                    <input type="hidden" name="log_sheet_ids" value="[]" id="dprLogSheetIdsJson">
                    
                  </div>
                  <div id="dprBatchDetailStrip" class="dpr-batch-detail-cols">
                    <div class="cu-field">
                      <label class="cu-label" for="dprMfgDisplay">MFG date</label>
                      <input type="text" id="dprMfgDisplay" class="cu-input" readonly tabindex="-1" placeholder="—" autocomplete="off">
                    </div>
                    <div class="cu-field">
                      <label class="cu-label" for="dprExpDisplay">EXP date</label>
                      <input type="text" id="dprExpDisplay" class="cu-input" readonly tabindex="-1" placeholder="—" autocomplete="off">
                    </div>
                    <div class="cu-field">
                      <label class="cu-label" for="dprBatchSizeDisplay">Batch size</label>
                      <input type="text" id="dprBatchSizeDisplay" class="cu-input cu-num" readonly tabindex="-1" placeholder="—" autocomplete="off">
                    </div>
                  </div>
                </div>

                <div id="dprLayerDetailStrip" class="dpr-row-layer-row">
                  <div class="cu-field">
                    <label class="cu-label" for="dprTabletLayer">Layer</label>
                    <input type="text" id="dprTabletLayer" class="cu-input" readonly tabindex="-1" placeholder="—" autocomplete="off">
                  </div>
                  <div class="cu-field">
                    <label class="cu-label" for="dprLayerColour">Layer colour</label>
                    <input type="text" id="dprLayerColour" class="cu-input" readonly tabindex="-1" placeholder="—" autocomplete="off">
                  </div>
                  <div class="cu-field">
                    <label class="cu-label" for="dprBatchRem">Batch remarks</label>
                    <input type="text" name="batch_rem" class="cu-input" id="dprBatchRem" maxlength="30" autocomplete="off">
                    
                  </div>
                </div>

                <div class="cu-field">
                  <label class="cu-label" for="dprSpecSelect">Specification <span class="req">*</span></label>
                  <select id="dprSpecSelect" class="cu-select searchable-dropdown" autocomplete="off">
                    <option value="">— Select specification —</option>
                  </select>
                  <input type="hidden" name="specification_id" id="dprSpecId">
                  
                </div>

                <div class="dpr-row-qty-line" id="dprRowQtyLine">
                  <div class="cu-field" id="dprFieldLotNoWrap">
                    <label class="cu-label" for="dprLotNo">Lot nos. <span class="req">*</span></label>
                    <input type="number" name="lot_no" class="cu-input cu-num" id="dprLotNo" min="0" max="9999">
                    
                  </div>
                  <div class="cu-field" id="dprFieldQtyKgWrap">
                    <label class="cu-label" for="dprQtyKg">Qty (kg) <span class="req">*</span></label>
                    <input type="text" name="qty_kg" class="cu-input cu-num" id="dprQtyKg" inputmode="decimal" autocomplete="off">
                    
                  </div>
                  <div class="cu-field" id="dprFieldQtyNosWrap">
                    <label class="cu-label" for="dprQtyNos">Qty (nos.) <span class="req">*</span></label>
                    <input type="number" name="qty_nos" class="cu-input cu-num" id="dprQtyNos" min="0" autocomplete="off">
                    
                  </div>
                  <div class="cu-field" id="dprFieldSectionQtyWrap">
                    <label class="cu-label" for="dprSectionQty"><span id="dprSectionQtyLabelText">Section qty (optional)</span></label>
                    <input type="text" name="section_qty" class="cu-input cu-num" id="dprSectionQty" inputmode="decimal" autocomplete="off">
                    
                  </div>
                </div>

                <div class="cu-row-3-eq">
                  <div class="cu-field">
                    <label class="cu-label" for="dprStartTime">Start time <span class="req">*</span></label>
                    <input type="time" name="start_time" class="cu-input" id="dprStartTime" required>
                    
                  </div>
                  <div class="cu-field">
                    <label class="cu-label" for="dprEndTime">End time <span class="req">*</span></label>
                    <input type="time" name="end_time" class="cu-input" id="dprEndTime" required>
                    
                  </div>
                  <div class="cu-field">
                    <label class="cu-label" for="dprTotalTime">Total time</label>
                    <input type="text" id="dprTotalTime" class="cu-input" readonly tabindex="-1" placeholder="—" autocomplete="off">
                  </div>
                </div>

                <div class="dpr-row-operators">
                  <div class="cu-field dpr-field--op dpr-field--operators">
                    <div class="dpr-operator-heading">
                      <div>
                        <label class="cu-label" for="dprOperators">Operators <span class="req">*</span></label>
                      </div>
                      <span id="dprOperatorCount" class="dpr-operator-count">0 selected</span>
                    </div>
                    <div class="dpr-operator-dropdown">
                      <button type="button" id="dprOperatorToggle" class="dpr-operator-toggle" aria-expanded="false" aria-controls="dprOperators">
                        <span id="dprOperatorSelection">Choose operators</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                      </button>
                      <div id="dprOperators" class="dpr-operator-checkboxes" aria-label="Operators" data-selected-operators="None"></div>
                    </div>
                    
                  </div>
                  <div class="cu-field dpr-field--helpers">
                    <label class="cu-label" for="dprHelpers">No. of helpers <span class="req">*</span></label>
                    <input type="number" name="no_of_helper" class="cu-input cu-num" id="dprHelpers" min="0" max="999" required>
                    
                  </div>
                </div>

                <div class="cu-field dpr-field--remarks-full">
                  <label class="cu-label" for="dprRemarks">Remarks</label>
                  <textarea name="remarks" cols="40" rows="1" class="cu-textarea" id="dprRemarks" maxlength="500">
</textarea>
                  
                </div>

              </div>
            </div>
          </div>

          <div class="cu-actions dpr-actions">
            <div aria-hidden="true"></div>
            <button type="submit" class="btn-save btn-save-main" id="dprSaveBtn">
              <i class="bi bi-check2-circle"></i> Save DPR
            </button>
            <a href="/transactions/dpr/" class="btn-cancel" id="dprClear"><i class="bi bi-x-lg"></i> Clear</a>
          </div>

          <aside class="dpr-status-col">
            <div class="cu-section txn-section dpr-section-block dpr-section-no-strip dpr-status-section">
              <h3 class="txn-section-title">Section-wise selected batch production status</h3>
              <div class="cu-section-fields dpr-status-fields">
                <div class="dpr-panel-shell dpr-status-panel-inner">
                  <div class="dpr-status-scroll">
                    <table class="dpr-table dpr-table--status">
                      <colgroup>
                        <col class="dpr-status-col-section">
                        <col class="dpr-status-col-qty">
                      </colgroup>
                      <thead>
                        <tr>
                          <th class="dpr-status-col-section">Section</th>
                          <th class="dpr-status-col-qty">Qty (nos.)</th>
                        </tr>
                      </thead>
                      <tbody id="dprStatusBody">
                        <tr><td colspan="2" class="dpr-muted">Select a batch to load totals…</td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </aside>
        </div>

        <div class="dpr-data-block">
          <div class="dpr-toolbar">
            <div class="dpr-toolbar-controls">
              <span class="dpr-toolbar-label">Date range (not more than 30 days):</span>
              <div class="cu-field dpr-toolbar-field">
                <label class="cu-label sr-only" for="dprGridStart">Start</label>
                <input type="date" id="dprGridStart" class="cu-input">
              </div>
              <div class="cu-field dpr-toolbar-field">
                <label class="cu-label sr-only" for="dprGridEnd">End</label>
                <input type="date" id="dprGridEnd" class="cu-input">
              </div>
              <button type="button" class="btn-save dpr-toolbar-btn" id="dprShowGrid">
                <i class="bi bi-table"></i> Show data
              </button>
            </div>
            <div class="dpr-toolbar-err" id="dprGridErrWrap">
              <span class="field-error" id="dprGridErr" role="alert"></span>
            </div>
          </div>

          <div class="table-card dpr-grid-table-card">
            <div class="table-card-header">
              <i class="bi bi-table"></i>
              <h3>Saved DPR entries</h3>
            </div>
            <div class="table-scroll-body">
              <table>
                <thead>
                  <tr>
                    <th class="col-idx">#</th>
                    <th>Date</th>
                    <th>Section</th>
                    <th>Machine</th>
                    <th>Shift</th>
                    <th>Status</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Batch</th>
                    <th class="dpr-col-qty-left">Qty (nos.)</th>
                    <th>Total time</th>
                    <th class="col-actions">Actions</th>
                  </tr>
                </thead>
                <tbody id="dprGridBody">
                  <tr><td colspan="12" class="dpr-muted">Set a date range and choose Show data.</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>


  </main>

  

